REPOBRAIN_LOG_LEVEL=INFO
REPOBRAIN_DB_POOL_SIZE=5
REPOBRAIN_DB_MAX_OVERFLOW=5
REPOBRAIN_DB_POOL_TIMEOUT=10

# Compose uses a disposable password by default. To override it before creating
# a new database volume, set POSTGRES_PASSWORD once to the raw password.
# For an external database outside this Compose stack, set REPOBRAIN_DATABASE_URL
# to a postgresql+asyncpg URL through your environment.

# Optional answer provider. Set both endpoint and model to enable generation.
# REPOBRAIN_GENERATION_ENDPOINT=https://llm.example.invalid/v1/chat/completions
# REPOBRAIN_GENERATION_MODEL=your-configured-model
# Supply REPOBRAIN_GENERATION_API_KEY through the process environment if required.
# REPOBRAIN_GENERATION_TIMEOUT=30
# REPOBRAIN_GENERATION_CONCURRENCY=2
